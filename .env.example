# RDS — el endpoint lo encuentras en la consola de AWS > RDS > tu instancia
RDS_HOST=tu-instancia.xxxxxxxxxxxx.us-east-1.rds.amazonaws.com

# Credenciales de la BD (las mismas que configuraste al crear el RDS)
POSTGRES_USER=odoo
POSTGRES_PASSWORD=CAMBIAR_POR_CONTRASEÑA_SEGURA
POSTGRES_DB=odoo

# Odoo
# NOTA: docker-compose.prod.yml no lee esta variable — no tiene efecto por sí sola.
# La contraseña del gestor de BD se pone a mano en admin_passwd dentro de odoo.prod.conf.
ODOO_ADMIN_PASSWD=CAMBIAR_POR_CONTRASEÑA_SEGURA
