<odoo>
    <data noupdate="0">
        <record id="mail_template_ticket_cerrado" model="mail.template">
            <field name="name">Helpdesk - Ticket Cerrado con Resumen PDF</field>
            <field name="model_id" ref="helpdesk_mgmt.model_helpdesk_ticket"/>
            <field name="subject">Ticket {{ object.number }} cerrado — {{ object.name }}</field>
            <field name="body_html"><![CDATA[
<div style="font-family: Arial, sans-serif; color: #333;">
    <p>Hola,</p>
    <p>
        El ticket <strong>#<t t-esc="object.number"/> — <t t-esc="object.name"/></strong>
        ha sido <strong>cerrado</strong> satisfactoriamente.
    </p>
    <p>
        Encontrarás adjunto un PDF con el resumen completo del ticket:
        la descripción del problema y el historial de todo lo que se realizó durante la atención.
    </p>
    <p t-if="object.user_id">
        Atendido por: <strong><t t-esc="object.user_id.name"/></strong>
    </p>
    <p>Si tienes alguna duda o el problema persiste, no dudes en contactarnos.</p>
    <p>
        Saludos,<br/>
        <t t-esc="object.company_id.name"/>
    </p>
</div>
            ]]></field>
            <field name="report_template_ids" eval="[(4, ref('helpdesk_mgmt.action_report_ticket_cierre'))]"/>
            <field name="auto_delete" eval="True"/>
        </record>
    </data>
</odoo>
