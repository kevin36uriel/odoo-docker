<odoo>
    <data noupdate="0">

        <record id="mail_template_ticket_confirmacion" model="mail.template">
            <field name="name">Confirmación ticket cliente</field>
            <field name="model_id" ref="helpdesk_mgmt.model_helpdesk_ticket"/>
            <field name="subject">Ticket #{{ object.id }}: {{ object.name }} — Asignado</field>
            <field name="partner_to"></field>
            <field name="email_to"></field>
            <field name="body_html"><![CDATA[
<table width="100%" cellpadding="0" cellspacing="0" bgcolor="#f0f2f5" style="font-family:Arial,Helvetica,sans-serif;background-color:#f0f2f5;">
  <tr>
    <td align="center" style="padding:32px 16px;">

      <table width="600" cellpadding="0" cellspacing="0" style="background-color:#ffffff;">

        <!-- HEADER -->
        <tr>
          <td bgcolor="#ffffff" align="center" style="background-color:#ffffff;padding:28px 40px 20px 40px;border-bottom:4px solid #0f2d6e;">
            <t t-set="logo_ps" t-value="env.ref('helpdesk_mgmt.logo_ps', raise_if_not_found=False)"/>
            <img t-if="logo_ps and logo_ps.datas"
                 t-att-src="'data:image/png;base64,' + logo_ps.datas.decode('ascii')"
                 alt="Punto Singular" width="180" height="82"
                 style="display:block;margin:0 auto;border:0;"/>
            <p style="margin:14px 0 0 0;color:#0f2d6e;font-size:12px;letter-spacing:2px;text-transform:uppercase;">
              Sistema de Soporte
            </p>
          </td>
        </tr>

        <!-- BANDA DE ESTADO -->
        <tr>
          <td bgcolor="#1565c0" align="center" style="background-color:#1565c0;padding:11px 40px;">
            <p style="margin:0;color:#ffffff;font-size:14px;font-weight:bold;">
              Ticket asignado &nbsp;&#x2014;&nbsp; #<t t-esc="object.id"/>
            </p>
          </td>
        </tr>

        <!-- CUERPO -->
        <tr>
          <td style="padding:32px 40px 24px 40px;">

            <p style="margin:0 0 18px 0;font-size:15px;color:#222222;line-height:1.6;">
              Hola,
            </p>
            <p style="margin:0 0 24px 0;font-size:14px;color:#444444;line-height:1.7;">
              Te informamos que el siguiente ticket ha sido <strong>registrado y asignado</strong>
              a un responsable que lo atenderá a la brevedad.
            </p>

            <!-- Nombre del ticket destacado -->
            <table width="100%" cellpadding="0" cellspacing="0"
                   style="border-left:4px solid #0f2d6e;background-color:#f5f7fa;margin-bottom:24px;">
              <tr>
                <td style="padding:16px 20px;">
                  <p style="margin:0 0 4px 0;font-size:11px;color:#888888;text-transform:uppercase;letter-spacing:1px;">
                    Referencia del ticket
                  </p>
                  <p style="margin:0;font-size:17px;font-weight:bold;color:#0f2d6e;">
                    #<t t-esc="object.id"/> &mdash; <t t-esc="object.name"/>
                  </p>
                </td>
              </tr>
            </table>

            <!-- Tabla de detalles -->
            <table width="100%" cellpadding="0" cellspacing="0"
                   style="border:1px solid #dde3ec;border-collapse:collapse;margin-bottom:24px;">
              <tr>
                <td width="38%" bgcolor="#f5f7fa"
                    style="padding:11px 16px;font-size:13px;font-weight:bold;color:#555555;
                           border-bottom:1px solid #dde3ec;background-color:#f5f7fa;">
                  Responsable
                </td>
                <td style="padding:11px 16px;font-size:14px;color:#222222;border-bottom:1px solid #dde3ec;">
                  <t t-esc="object.user_id.name if object.user_id else '—'"/>
                </td>
              </tr>
              <tr>
                <td bgcolor="#f5f7fa"
                    style="padding:11px 16px;font-size:13px;font-weight:bold;color:#555555;
                           border-bottom:1px solid #dde3ec;background-color:#f5f7fa;">
                  Contacto
                </td>
                <td style="padding:11px 16px;font-size:14px;color:#222222;border-bottom:1px solid #dde3ec;">
                  <t t-esc="object.partner_id.name if object.partner_id else (object.partner_name or '—')"/>
                </td>
              </tr>
              <tr>
                <td bgcolor="#f5f7fa"
                    style="padding:11px 16px;font-size:13px;font-weight:bold;color:#555555;
                           border-bottom:1px solid #dde3ec;background-color:#f5f7fa;">
                  Equipo
                </td>
                <td style="padding:11px 16px;font-size:14px;color:#222222;border-bottom:1px solid #dde3ec;">
                  <t t-esc="object.team_id.name or '—'"/>
                </td>
              </tr>
              <tr>
                <td bgcolor="#f5f7fa"
                    style="padding:11px 16px;font-size:13px;font-weight:bold;color:#555555;
                           vertical-align:top;background-color:#f5f7fa;">
                  Descripci&#243;n
                </td>
                <td style="padding:11px 16px;font-size:14px;color:#222222;">
                  <t t-out="object.description or '—'"/>
                </td>
              </tr>
            </table>

            <p style="margin:0;font-size:13px;color:#777777;line-height:1.7;">
              Si tienes informaci&#243;n adicional que compartir, responde directamente a este correo
              y tu mensaje quedar&#225; registrado en el ticket.
            </p>

          </td>
        </tr>

        <!-- SEPARADOR -->
        <tr>
          <td style="padding:0 40px;">
            <table width="100%" cellpadding="0" cellspacing="0">
              <tr><td style="border-top:1px solid #dde3ec;font-size:0;">&nbsp;</td></tr>
            </table>
          </td>
        </tr>

        <!-- FOOTER / FIRMA -->
        <tr>
          <td bgcolor="#f5f7fa" style="background-color:#f5f7fa;padding:20px 40px;">
            <table width="100%" cellpadding="0" cellspacing="0">
              <tr>
                <td width="120" valign="middle">
                  <t t-set="logo_ps" t-value="env.ref('helpdesk_mgmt.logo_ps', raise_if_not_found=False)"/>
                  <img t-if="logo_ps and logo_ps.datas"
                       t-att-src="'data:image/png;base64,' + logo_ps.datas.decode('ascii')"
                       alt="Punto Singular" width="100" height="46"
                       style="display:block;border:0;"/>
                </td>
                <td valign="middle" style="padding-left:16px;border-left:2px solid #ccd5e0;">
                  <p style="margin:0;font-size:13px;font-weight:bold;color:#0f2d6e;">
                    <t t-esc="object.company_id.name"/>
                  </p>
                  <p style="margin:3px 0 0 0;font-size:12px;color:#888888;">
                    Equipo de Soporte T&#233;cnico
                  </p>
                  <p style="margin:2px 0 0 0;font-size:11px;color:#aaaaaa;">
                    Correo autom&#225;tico &#x2014; no responder directamente a este mensaje.
                  </p>
                  <p style="margin:6px 0 0 0;font-size:11px;color:#aaaaaa;">
                    <t t-esc="object.name"/> (#<t t-esc="object.id"/>)
                  </p>
                </td>
              </tr>
            </table>
          </td>
        </tr>

      </table>
      <!-- /600 -->

    </td>
  </tr>
</table>
            ]]></field>
        </record>

    </data>
</odoo>
