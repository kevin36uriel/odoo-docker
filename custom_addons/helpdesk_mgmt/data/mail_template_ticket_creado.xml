<odoo>
    <data noupdate="0">

        <record id="mail_template_ticket_confirmacion" model="mail.template">
            <field name="name">Confirmación ticket cliente</field>
            <field name="model_id" ref="helpdesk_mgmt.model_helpdesk_ticket"/>
            <field name="subject">Ticket #{{ object.id }}: {{ object.name }} — Asignado</field>
            <field name="partner_to"></field>
            <field name="email_to"></field>
            <field name="body_html"><![CDATA[
                <div>
                    <p>El ticket <strong>#<t t-esc="object.id"/>: <t t-esc="object.name"/></strong> ha sido asignado a <strong><t t-esc="object.user_id.name"/></strong>.</p>
                    <t t-if="object.partner_id or object.partner_email">
                        <p>Contacto: <t t-esc="object.partner_id.name if object.partner_id else object.partner_name"/></p>
                    </t>
                    <p>Descripción: <t t-out="object.description or '—'"/></p>
                    <p>Equipo: <t t-esc="object.team_id.name or '—'"/></p>
                    <br/>
                    <p>Equipo de soporte</p>
                </div>
            ]]></field>
        </record>

    </data>
</odoo>
