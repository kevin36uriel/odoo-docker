<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- El action se actualiza con -u (noupdate="0") -->
    <data noupdate="0">
        <record id="action_report_monthly_pdf" model="ir.actions.report">
            <field name="name">Reporte Mensual de Tickets</field>
            <field name="model">helpdesk.report.monthly.wizard</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">oca_helpdesk_reports.report_monthly_pdf_template</field>
            <field name="report_file">oca_helpdesk_reports.report_monthly_pdf_template</field>
            <field name="paperformat_id" ref="base.paperformat_euro"/>
        </record>
    </data>

    <!--
        El template está con noupdate="1":
        Los cambios hechos desde Ajustes → Técnico → Informes → Editar plantilla
        NO se pierden al hacer -u oca_helpdesk_reports.
        Para forzar reset desde código, cambiar temporalmente a noupdate="0".

        Los valores dinámicos (listas de tickets completados/pendientes, fechas
        en español, gráfica) no salen de doc.line_ids: los calcula
        models/report_monthly_pdf.py (report.oca_helpdesk_reports.report_monthly_pdf_template
        ._get_report_values) y los deja en el diccionario "report_data", indexado
        por el id del wizard.
    -->
    <data noupdate="1">
        <template id="report_monthly_pdf_template">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="doc">
                    <t t-set="rd" t-value="report_data[doc.id]"/>
                    <t t-call="web.external_layout">
                        <div class="page">
                            <style>
                                .rm-title { font-size: 22px; font-weight: bold; color: #122A59; margin-bottom: 2px; }
                                .rm-period { color: #666; font-size: 12px; margin-bottom: 18px; }
                                .rm-intro {
                                    background: #f0f4fb; border-left: 4px solid #3B8EDE;
                                    border-radius: 4px; padding: 12px 16px; margin-bottom: 20px;
                                    font-size: 12.5px; line-height: 1.55; color: #2c2c2c; text-align: justify;
                                }
                                .rm-summary { display: flex; gap: 16px; margin-bottom: 22px; }
                                .rm-summary-box {
                                    flex: 1; background: #122A59; border-radius: 4px;
                                    padding: 10px 8px; text-align: center; color: white;
                                }
                                .rm-summary-box.pending { background: #3B8EDE; }
                                .rm-summary-box .value { font-size: 22px; font-weight: bold; }
                                .rm-summary-box .label { font-size: 10.5px; opacity: 0.9; }

                                .rm-section-title {
                                    font-size: 14px; font-weight: bold; color: #122A59;
                                    border-bottom: 2px solid #d8e0ee; padding-bottom: 4px; margin: 18px 0 10px 0;
                                }
                                .rm-ticket-row {
                                    display: flex; justify-content: space-between; align-items: center;
                                    border-left: 3px solid #3B8EDE; background: #fafbfd;
                                    padding: 5px 10px; margin-bottom: 4px; font-size: 11px;
                                }
                                .rm-ticket-row.completed { border-left-color: #2f9e5c; }
                                .rm-ticket-row .rm-ticket-name { color: #222; }
                                .rm-ticket-row .rm-ticket-number { color: #122A59; font-weight: bold; margin-right: 6px; }
                                .rm-ticket-row .rm-ticket-meta { color: #777; font-size: 10px; white-space: nowrap; margin-left: 8px; }
                                .rm-empty { color: #888; font-size: 11.5px; font-style: italic; padding: 6px 0 12px 0; }
                                .rm-extra-note { color: #888; font-size: 10.5px; font-style: italic; margin-top: 2px; }

                                .rm-chart-wrap { text-align: center; margin-top: 22px; page-break-inside: avoid; }
                                .rm-chart-wrap img { max-width: 100%; }
                            </style>

                            <div class="rm-title">Reporte Mensual de Tickets</div>
                            <div class="rm-period">
                                Período del <t t-esc="rd['date_from_es']"/> al <t t-esc="rd['date_to_es']"/>
                                <t t-if="doc.team_id"> · Equipo: <t t-esc="doc.team_id.name"/></t>
                                <t t-if="doc.user_id"> · Agente: <t t-esc="doc.user_id.name"/></t>
                            </div>

                            <div class="rm-intro">
                                En el transcurso del período comprendido entre el
                                <b><t t-esc="rd['date_from_es']"/></b> y el
                                <b><t t-esc="rd['date_to_es']"/></b>, el equipo de soporte de Punto Singular
                                gestionó un total de <b><t t-esc="doc.total_tickets"/></b> ticket(s).
                                De estos, <b><t t-esc="doc.total_resolved"/></b> se completaron y cerraron
                                satisfactoriamente, mientras que <b><t t-esc="doc.total_pending"/></b>
                                no se lograron completar dentro del período y permanecen abiertos o en proceso.
                            </div>

                            <div class="rm-summary">
                                <div class="rm-summary-box">
                                    <div class="value"><t t-esc="doc.total_tickets"/></div>
                                    <div class="label">TOTAL DE TICKETS</div>
                                </div>
                                <div class="rm-summary-box">
                                    <div class="value"><t t-esc="doc.total_resolved"/></div>
                                    <div class="label">COMPLETADOS</div>
                                </div>
                                <div class="rm-summary-box pending">
                                    <div class="value"><t t-esc="doc.total_pending"/></div>
                                    <div class="label">NO COMPLETADOS</div>
                                </div>
                            </div>

                            <div class="rm-section-title">Tickets completados</div>
                            <t t-if="rd['completed']">
                                <t t-foreach="rd['completed']" t-as="ticket">
                                    <div class="rm-ticket-row completed">
                                        <span>
                                            <span class="rm-ticket-number"><t t-esc="ticket.number"/></span>
                                            <span class="rm-ticket-name"><t t-esc="ticket.name"/></span>
                                        </span>
                                        <span class="rm-ticket-meta">
                                            <t t-esc="ticket.user_id.name or 'Sin asignar'"/>
                                            <t t-if="ticket.closed_date">
                                                · <t t-esc="ticket.closed_date.strftime('%d/%m/%Y')"/>
                                            </t>
                                        </span>
                                    </div>
                                </t>
                                <div class="rm-extra-note" t-if="rd['completed_extra']">
                                    + <t t-esc="rd['completed_extra']"/> ticket(s) completados adicionales no
                                    mostrados en este listado.
                                </div>
                            </t>
                            <div class="rm-empty" t-else="">
                                No se completó ningún ticket en el período seleccionado.
                            </div>

                            <div class="rm-section-title">Tickets no completados</div>
                            <t t-if="rd['pending']">
                                <t t-foreach="rd['pending']" t-as="ticket">
                                    <div class="rm-ticket-row">
                                        <span>
                                            <span class="rm-ticket-number"><t t-esc="ticket.number"/></span>
                                            <span class="rm-ticket-name"><t t-esc="ticket.name"/></span>
                                        </span>
                                        <span class="rm-ticket-meta">
                                            <t t-esc="ticket.user_id.name or 'Sin asignar'"/>
                                            · <t t-esc="ticket.stage_id.name"/>
                                        </span>
                                    </div>
                                </t>
                                <div class="rm-extra-note" t-if="rd['pending_extra']">
                                    + <t t-esc="rd['pending_extra']"/> ticket(s) pendientes adicionales no
                                    mostrados en este listado.
                                </div>
                            </t>
                            <div class="rm-empty" t-else="">
                                No quedaron tickets pendientes en el período seleccionado.
                            </div>

                            <div class="rm-chart-wrap">
                                <img t-if="rd['chart_b64']"
                                     t-att-src="'data:image/png;base64,' + rd['chart_b64']"
                                     alt="Gráfica de tickets por agente"/>
                                <div class="rm-empty" t-else="">
                                    No hay datos suficientes para generar la gráfica.
                                </div>
                            </div>
                        </div>
                    </t>
                </t>
            </t>
        </template>
    </data>
</odoo>
