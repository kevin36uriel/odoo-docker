<odoo>
    <data noupdate="1">
        <record id="ir_cron_process_telegram_notifications" model="ir.cron">
            <field name="name">Procesar notificaciones Helpdesk por Telegram</field>
            <field name="model_id" ref="model_ps_telegram_notification"/>
            <field name="state">code</field>
            <field name="code">model._cron_process_pending()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
