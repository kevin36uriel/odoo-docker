<odoo>
    <record id="view_helpdesk_team_form_telegram" model="ir.ui.view">
        <field name="name">helpdesk.ticket.team.form.telegram</field>
        <field name="model">helpdesk.ticket.team</field>
        <field name="inherit_id" ref="helpdesk_mgmt.view_helpdesk_team_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='show_in_portal']" position="after">
                <field
                    name="telegram_chat_id"
                    groups="helpdesk_mgmt.group_helpdesk_manager"
                />
            </xpath>
        </field>
    </record>
</odoo>
