<odoo>
    <data noupdate="1">

        <!-- Activar idioma español México -->
        <function model="res.lang" name="_activate_lang">
            <value>es_MX</value>
        </function>

        <!-- Idioma del partner de la compañía principal -->
        <record id="base.main_partner" model="res.partner">
            <field name="lang">es_MX</field>
        </record>

    </data>
</odoo>
