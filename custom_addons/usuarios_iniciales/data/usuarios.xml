<odoo>
    <data noupdate="1">

        <!--
            ROLES DISPONIBLES EN ODOO:
            ─────────────────────────────────────────────────────────────────
            base.group_user          → Usuario interno  (acceso al backend)
            base.group_portal        → Portal           (solo ve su portal web)
            base.group_public        → Público          (sin login, visitantes)

            ROLES DE SISTEMA (no asignar manualmente):
            base.group_system        → Configuración técnica (settings avanzados)
            base.group_erp_manager   → Administrador ERP

            Para asignar un rol:
            <field name="groups_id" eval="[(4, ref('base.group_user'))]"/>
            ─────────────────────────────────────────────────────────────────
        -->

        <!-- Reemplazar admin por defecto -->
        <record id="base.user_admin" model="res.users">
            <field name="name">Administrador</field>
            <field name="login">administrador</field>
            <field name="email">kevin36uriel@gmail.com</field>
            <field name="password">12345</field>
        </record>

        <!-- Usuario interno -->
        <record id="user_usuario_generic" model="res.users">
            <field name="name">Usuario</field>
            <field name="login">usuario</field>
            <field name="email">kevin597uriel@gmail.com</field>
            <field name="password">12345</field>
            <field name="groups_id" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Cliente (portal) -->
        <record id="user_cliente_generic" model="res.users">
            <field name="name">Cliente</field>
            <field name="login">cliente</field>
            <field name="email">kevin789uriel@gmail.com</field>
            <field name="password">12345</field>
            <field name="groups_id" eval="[(4, ref('base.group_portal'))]"/>
        </record>

    </data>
</odoo>